
Процедура УстановкаОтветственногоПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Не ЗначениеЗаполнено(Источник.Ответственный) Тогда
		Источник.Ответственный = ВендингПривилегированный.ТекущийСотрудник();
	КонецЕсли;
	
КонецПроцедуры 

Процедура ПроверитьОтрицательныеОстатки(ИмяРегистра, ИмяИзмеренияМеста,
			ЗначениеМеста, Регистратор, МоментКонтроля, Отказ) Экспорт

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура      КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.@Рег.Остатки(
	|			&МоментКонтроля,
	|			@Место = &ЗначениеМеста
	|				И Номенклатура В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ Д.Номенклатура
	|					 ИЗ РегистрНакопления.@Рег КАК Д
	|					 ГДЕ Д.Регистратор = &Регистратор)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "@Рег",   ИмяРегистра);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "@Место", ИмяИзмеренияМеста);

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МоментКонтроля", Новый Граница(МоментКонтроля, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Регистратор",    Регистратор);
	Запрос.УстановитьПараметр("ЗначениеМеста",  ЗначениеМеста);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Отказ = Истина;

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(
			"Недостаточно «%1» (%2): не хватает %3.",
			Выборка.Номенклатура,
			ЗначениеМеста,
			Формат(-Выборка.Остаток, "ЧДЦ=3; ЧН=0"));
		Сообщение.Сообщить();

	КонецЦикла;

КонецПроцедуры
