Процедура ЗаполнитьПоСчетчикам() Экспорт

	Если Не ЗначениеЗаполнено(Автомат) Тогда
		ВызватьИсключение "Не заполнен автомат.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Напитки.Ссылка                КАК Напиток,
	|	ЕСТЬNULL(Показания.Счетчик, 0) КАК ПредыдущееПоказание,
	|	ЕСТЬNULL(Цены.Цена, 0)         КАК Цена
	|ИЗ
	|	Справочник.Напитки КАК Напитки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПоказанияСчетчиков.СрезПоследних(
	|				&НаМомент, Автомат = &Автомат) КАК Показания
	|			ПО Напитки.Ссылка = Показания.Напиток
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНапитков.СрезПоследних(
	|				&НаМомент, Автомат = &Автомат) КАК Цены
	|			ПО Напитки.Ссылка = Цены.Напиток
	|ГДЕ
	|	НЕ Напитки.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Напитки.КодНаАвтомате";

	Запрос.УстановитьПараметр("Автомат", Автомат);

	Запрос.УстановитьПараметр("НаМомент",
		?(ЭтоНовый(), Дата, Новый Граница(МоментВремени(), ВидГраницы.Исключая)));

	Продажи.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ЗначениеЗаполнено(ПериодС) И ЗначениеЗаполнено(ПериодПо) И ПериодС > ПериодПо Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Начало периода позже его окончания.";
		Сообщение.Поле  = "ПериодС";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	ВыручкаНаличными = Продажи.Итог("Сумма") - ВыручкаБезналом;

КонецПроцедуры