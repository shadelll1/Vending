&НаКлиенте
Процедура ПродажиПоказаниеСчетчикаПриИзменении(Элемент)
	ПересчитатьСтрокуИВыручку();
КонецПроцедуры

&НаКлиенте
Процедура ПродажиЦенаПриИзменении(Элемент)
	ПересчитатьСтрокуИВыручку();
КонецПроцедуры

&НаКлиенте
Процедура ВыручкаБезналомПриИзменении(Элемент)
	ПересчитатьВыручку();
КонецПроцедуры

&НаКлиенте
Процедура ПродажиПослеУдаления(Элемент)
	ПересчитатьВыручку();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокуИВыручку()

	Строка = Элементы.Продажи.ТекущиеДанные;
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Строка.Продано = Макс(Строка.ПоказаниеСчетчика - Строка.ПредыдущееПоказание, 0);
	Строка.Сумма   = Строка.Продано * Строка.Цена;

	ПересчитатьВыручку();

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьВыручку()

	Всего = 0;
	Для Каждого Строка Из Объект.Продажи Цикл
		Всего = Всего + Строка.Сумма;
	КонецЦикла;

	Объект.ВыручкаНаличными = Всего - Объект.ВыручкаБезналом;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоСчетчикам(Команда)
	ЗаполнитьПоСчетчикамНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоСчетчикамНаСервере()

	Документ = РеквизитФормыВЗначение("Объект");
	Документ.ЗаполнитьПоСчетчикам();
	ЗначениеВРеквизитФормы(Документ, "Объект");

КонецПроцедуры